
# ===== Keycloak : comptes et connexion (modèle : keycloak/docker.example.env) ================
# Keycloak garde les comptes, les mots de passe, et fabrique les jetons. Ses pages de connexion
# ont l'allure de l'outil et passent par l'interface (<APP_FRONTEND_URL>/auth). Voir docs/keycloak.md.

# Sa base : la même que la nôtre (POSTGRES_DB), dans son propre schéma « keycloak », avec son
# propre utilisateur, créés par l'image PostgreSQL au premier démarrage (vérifié par docker-deploy.zsh).
KC_DB_URL=jdbc:postgresql://suivi-delivery-postgres-local:5432/suivi_delivery
KC_DB_USERNAME=keycloak
# Tiré au hasard par docker-deploy.zsh à la création de docker.env
KC_DB_PASSWORD=
# Son adresse vue du navigateur : celle de l'interface, suivie de /auth (vérifié par docker-deploy.zsh)
KC_HOSTNAME=http://localhost:8080/auth
# Console d'administration de Keycloak, sur ce poste seulement (http://localhost:8081/auth/admin) :
# son adresse, donnée au domaine « master » à chaque démarrage (keycloak/start.sh), et un
# administrateur provisoire de Keycloak (pas un compte de l'outil), tiré au hasard.
KC_HOSTNAME_ADMIN=http://localhost:8081/auth
KC_BOOTSTRAP_ADMIN_USERNAME=admin-keycloak
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Repris dans la configuration importée au PREMIER démarrage (keycloak/import/suivi-delivery.json) :
#   APP_ADMIN_PASSWORD          mot de passe du compte « admin » de l'outil (12 caractères au moins),
#                               tiré au hasard et affiché par docker-deploy.zsh ;
#   APP_KEYCLOAK_CLIENT_SECRET  clé du client de l'API (gestion des comptes), lue aussi par l'API.
# Les changer ensuite ne change rien (repartir de zéro : --reset).
APP_ADMIN_PASSWORD=
APP_KEYCLOAK_CLIENT_SECRET=
