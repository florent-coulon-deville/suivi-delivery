{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Réglages du chart Suivi de la delivery",
  "description": "Vérifie values.yaml et values-secret.yaml : un réglage inconnu ou du mauvais type arrête l'installation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "frontend",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "description": "placé devant chaque dépôt ; vide : noms courts (kind)"
        },
        "backend": {
          "$ref": "#/definitions/image"
        },
        "frontend": {
          "$ref": "#/definitions/image"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "server": {
          "type": "string",
          "description": "values-secret.yaml"
        },
        "user": {
          "type": "string",
          "description": "values-secret.yaml"
        },
        "password": {
          "type": "string",
          "description": "values-secret.yaml"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logLevel",
        "swagger"
      ],
      "properties": {
        "instanceName": {
          "type": "string",
          "maxLength": 40
        },
        "instanceColor": {
          "type": "string",
          "maxLength": 40
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "critical",
            "error",
            "warning",
            "info",
            "debug",
            "trace"
          ]
        },
        "swagger": {
          "type": "boolean"
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "storage",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "1 : l'API tourne ; 0 : arrêtée. Jamais plus (base SQLite sur un seul disque)"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "className": {
              "type": "string"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          },
          "description": "jamais « latest »"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "ephemeral-storage"
          ],
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": "string"
            },
            "ephemeral-storage": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "memory",
            "ephemeral-storage"
          ],
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": "string"
            },
            "ephemeral-storage": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
