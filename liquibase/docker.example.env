# ===== Liquibase : la structure de la base (modèle : liquibase/docker.example.env) ==========
# La base où appliquer la structure : les mêmes que POSTGRES_* (vérifié par docker-deploy.zsh).
# Adresse au format JDBC (Java) : jdbc:postgresql://<conteneur de la base>:<port>/<base>?currentSchema=<schéma>
# (le schéma de nos tables, APP_DB_SCHEMA de l'API : Liquibase y crée tout, ses deux tables de suivi comprises)
LIQUIBASE_COMMAND_URL=jdbc:postgresql://suivi-delivery-postgres-local:5432/suivi_delivery?currentSchema=suivi_delivery
LIQUIBASE_COMMAND_USERNAME=suivi_delivery
# Le même que POSTGRES_PASSWORD (rempli par docker-deploy.zsh à la création de docker.env)
LIQUIBASE_COMMAND_PASSWORD=

