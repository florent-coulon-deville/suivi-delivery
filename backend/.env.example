# Réglages de l'API (voir app/settings.py et docs/deploiement.md).
# Copier en .env puis lancer :  uv run --env-file .env python -m app
# Une ligne absente ou vide = valeur par défaut.

# Adresse d'écoute : 127.0.0.1 = ce poste seulement ; 0.0.0.0 = joignable de l'extérieur (conteneur)
APP_HOST=127.0.0.1
# Port d'écoute
APP_PORT=8000
# Détail des journaux : critical, error, warning, info, debug, trace
APP_LOG_LEVEL=info
# Documentation Swagger visible (/api/docs) : oui ou non
APP_DOCS=oui

# --- Base PostgreSQL (voir docs/postgresql.md) ---
# Vide : données EN MÉMOIRE, perdues à l'arrêt de l'API. Avec la base du poste
# (./deployment/docker-deploy.zsh postgres, puis liquibase) : APP_DB_HOST=localhost, et pour le mot de
# passe, la valeur de POSTGRES_PASSWORD dans deployment/docker.env.
APP_DB_HOST=
# Port, nom de la base, schéma de nos tables, utilisateur (vides : 5432, suivi_delivery, suivi_delivery,
# suivi_delivery)
APP_DB_PORT=
APP_DB_NAME=
APP_DB_SCHEMA=
APP_DB_USER=
# Mot de passe, obligatoire avec APP_DB_HOST
APP_DB_PASSWORD=

# --- Connexion par Keycloak (voir docs/keycloak.md) ---
# Adresse INTERNE de Keycloak, avec /auth (celui du poste : ./deployment/docker-deploy.zsh keycloak,
# console sur le port 8081). Vide : aucun jeton n'est accepté.
APP_KEYCLOAK_URL=http://localhost:8081/auth
# Clé du client « suivi-delivery-api » (écran Comptes) : APP_KEYCLOAK_CLIENT_SECRET de deployment/docker.env
APP_KEYCLOAK_CLIENT_SECRET=
# Adresse de l'interface (Keycloak servi sous <adresse>/auth : l'émetteur attendu dans les jetons),
# et de l'API (Swagger)
APP_FRONTEND_URL=http://localhost:8080
APP_API_URL=http://localhost:8000
