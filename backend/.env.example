# Réglages de l'API (voir app/settings.py et docs/deploiement.md).
# Copier en .env puis lancer :  uv run --env-file .env python -m app
# Une ligne absente ou vide = valeur par défaut.

# Adresse d'écoute : 127.0.0.1 = ce poste seulement ; 0.0.0.0 = joignable de l'extérieur (conteneur)
APP_HOST=127.0.0.1
# Port d'écoute
APP_PORT=8000
# Détail des journaux : critical, error, warning, info, debug, trace
APP_LOG_LEVEL=info
# Documentation Swagger visible (/api/docs) : oui ou non
APP_DOCS=oui

# --- Base SQLite (voir docs/sqlite.md) ---
# Le fichier des données, créé s'il n'existe pas, avec ses tables. Vide : données EN MÉMOIRE,
# perdues à l'arrêt de l'API.
APP_DB_FILE=donnees/suivi-delivery.sqlite
