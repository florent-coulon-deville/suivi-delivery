# ===== Backend : l'API (modèle : backend/docker.example.env) ================================

# 0.0.0.0 : joignable depuis les autres conteneurs (obligatoire dans un conteneur)
APP_HOST=0.0.0.0
APP_PORT=8000
# La base : un fichier SQLite, dans le volume monté sur /data (docker-deploy.zsh). Créé, avec ses
# tables, au premier démarrage.
APP_DB_FILE=/data/suivi-delivery.sqlite
# critical, error, warning, info, debug, trace
APP_LOG_LEVEL=info
# Swagger (/api/docs) : oui ou non
APP_DOCS=oui
