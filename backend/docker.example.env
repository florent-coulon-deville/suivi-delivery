# ===== Backend : l'API (modèle : backend/docker.example.env) ================================

# 0.0.0.0 : joignable depuis les autres conteneurs (obligatoire dans un conteneur)
APP_HOST=0.0.0.0
APP_PORT=8000
# La base : le conteneur PostgreSQL, et les mêmes valeurs que POSTGRES_* (vérifié par
# docker-deploy.zsh)
APP_DB_HOST=suivi-delivery-postgres-local
APP_DB_PORT=5432
APP_DB_NAME=suivi_delivery
APP_DB_SCHEMA=suivi_delivery
APP_DB_USER=suivi_delivery
# Le même que POSTGRES_PASSWORD (rempli par docker-deploy.zsh à la création de docker.env)
APP_DB_PASSWORD=
# critical, error, warning, info, debug, trace
APP_LOG_LEVEL=info
# Swagger (/api/docs) : oui ou non
APP_DOCS=oui
# Connexion par Keycloak (voir docs/keycloak.md) :
#   APP_KEYCLOAK_URL  adresse INTERNE de Keycloak (nom du conteneur + /auth) : clés de signature
#                     des jetons, gestion des comptes (avec APP_KEYCLOAK_CLIENT_SECRET, partie Keycloak) ;
#   APP_FRONTEND_URL  adresse de l'interface, telle que la tape le navigateur : Keycloak est servi
#                     sous <adresse>/auth (lue aussi par le frontend) ;
#   APP_API_URL       adresse de l'API (Swagger, développement).
APP_KEYCLOAK_URL=http://suivi-delivery-keycloak-local:8080/auth
APP_FRONTEND_URL=http://localhost:8080
APP_API_URL=http://localhost:8000
