# ===== Frontend : l'interface (modèle : frontend/docker.example.env) ========================

# Port d'écoute du site dans le conteneur
PORT=8080
# Adresse de l'API, appelée par le serveur Next.js : nom du conteneur backend + son port
# (APP_PORT du backend). Sur OpenShift : nom du service backend (court ou complet).
API_URL=http://suivi-delivery-backend-local:8000
# Adresse INTERNE de Keycloak (nom du conteneur + /auth) : échange des codes contre les jetons, et
# relais des pages de connexion sous <APP_FRONTEND_URL>/auth. APP_FRONTEND_URL est dans la partie
# du backend (plus haut), lue par tous les conteneurs.
KEYCLOAK_URL=http://suivi-delivery-keycloak-local:8080/auth
# Nom affiché dans le bandeau (supprimer la ligne pour ne pas avoir de bandeau)
INSTANCE_NAME=local
# Couleur du bandeau (ex. #2f9e44) ; sans cette ligne : rouge si « prod », orange sinon
# INSTANCE_COLOR=#2f9e44
