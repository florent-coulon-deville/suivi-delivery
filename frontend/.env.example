# Réglages de l'interface en développement (voir lib/settings.ts et docs/deploiement.md).
# Copier en .env : le serveur Next.js (« npm run dev ») le lit automatiquement.
# Une ligne absente ou vide = valeur par défaut.

# Adresse de l'API, appelée par le serveur Next.js (sans / final)
API_URL=http://127.0.0.1:8000
# Le port du site (défaut 5173 en développement, 8080 une fois déployé) ne se règle pas ici :
# il est lu avant le fichier .env. Le donner au lancement : PORT=3000 npm run dev
# Nom de l'instance, affiché en bandeau et dans le titre de l'onglet (vide = pas de bandeau)
INSTANCE_NAME=
# Couleur du bandeau, ex. #2f9e44 (défaut : rouge si le nom est « prod », orange sinon)
INSTANCE_COLOR=
# Connexion par Keycloak : adresse du site telle que la tape le navigateur (défaut http://localhost:<PORT>),
# qui sert aussi Keycloak sous /auth ; et adresse interne de Keycloak (avec /auth), où le serveur
# échange les codes contre les jetons et relaie les pages de connexion. Keycloak doit être lancé avec
# KC_HOSTNAME=<APP_FRONTEND_URL>/auth (docs/keycloak.md).
APP_FRONTEND_URL=http://localhost:5173
KEYCLOAK_URL=http://127.0.0.1:8081/auth
